        "query": "SELECT COALESCE('(time >= ' || min(first_time_ns)::text || ' AND time <= ' || max(last_time_ns)::text || ' AND (' || string_agg(influx_predicate, ' OR ' ORDER BY first_time_ns) || '))', '(time < 0 AND time > 0)') AS __text FROM (SELECT * FROM monitoring.cycle_catalog WHERE waveform_status IN ('stored', 'legacy') AND mode = 'cycle' AND machine_id IN ('55t', '160t') ORDER BY first_time_ns DESC, machine_id, session_id, cycle_id LIMIT CASE WHEN btrim(${n_cycles:sqlstring}) ~ '^[0-9]+$' THEN CASE WHEN length(btrim(${n_cycles:sqlstring})) > 9 THEN 100 ELSE LEAST(100, GREATEST(1, btrim(${n_cycles:sqlstring})::integer)) END ELSE 10 END) AS recent",
